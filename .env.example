# Local database used for partner credentials and API analysis records.
AUTH_DATABASE_URL=postgresql://<user>:<password>@localhost:5437/apis?sslmode=disable

# Bhoomi Suvidha application database, read-only from this service.
BHOOMI_DATABASE_URL=postgresql://<user>:<password>@localhost:5437/bhoomi_suvidha?sslmode=disable

PORT=8011

# Companion UPSIDA AI service.
AI_SERVICE_URL=http://127.0.0.1:8421

# UPSIDA SaveAssessment integration.
UPSIDA_API_BASE_URL=https://<upsida-api-host>/api
UPSIDA_API_TOKEN=<upsida-api-token>

# RS256 keypair used by this service.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=bhoomi-suvidha-partner-apis
JWT_EXPIRES_IN=24h

# MinIO/S3-compatible document storage.
MINIO_ENABLED=true
MINIO_ENDPOINT=http://127.0.0.1:9100
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=bhoomi-nm-docs
MINIO_REGION=us-east-1
MINIO_PRESIGN_EXPIRES_SEC=604800